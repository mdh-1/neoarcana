# All optional — with none set, the app uses local entropy and a mock interpreter.
RANDOM_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=

# Provider priority (first with a key wins; falls through on errors)
LLM_PROVIDERS=gemini,mistral,deepseek

# Model IDs — override here when a vendor retires a slug, no code change needed
#DEEPSEEK_MODEL=deepseek-v4-flash
#GEMINI_MODEL=gemini-3.5-flash-lite
#MISTRAL_MODEL=mistral-small-latest

READINGS_PER_HOUR=10
