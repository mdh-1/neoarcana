# /etc/systemd/system/neoarcana.service
[Unit]
Description=Neoarcana tarot reading service
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=neoarcana
Group=neoarcana
WorkingDirectory=/srv/neoarcana
Environment=PYTHONDONTWRITEBYTECODE=1

# ProtectSystem=strict makes the app directory read-only, so the reading
# database lives in the state directory (/var/lib/neoarcana) instead.
StateDirectory=neoarcana
Environment=READINGS_DB=/var/lib/neoarcana/readings.db

# --workers 1 is the right default rather than a hard requirement now
# that readings are in SQLite (verified: 60/60 concurrent fetches across
# 3 workers succeed, where 44 of 60 used to 404). One async worker is
# ample here, and the per-IP rate limiter is still process-local — N
# workers would mean N x READINGS_PER_HOUR before anyone is throttled.
#
# --proxy-headers + --forwarded-allow-ips lets the rate limiter see the
# real client IP from Caddy's X-Forwarded-For. Without it every request
# looks like 127.0.0.1 and the 11th reading site-wide gets a 429.
ExecStart=/srv/neoarcana/.venv/bin/uvicorn app.main:app \
    --host 127.0.0.1 --port 8001 \
    --workers 1 \
    --proxy-headers --forwarded-allow-ips=127.0.0.1

Restart=on-failure
RestartSec=5s

# Hardening: the app reads its own directory and talks to the network.
# It writes nothing to disk — readings are in memory, logs go to journald.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
