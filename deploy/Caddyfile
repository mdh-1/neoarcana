# Neoarcana — replaces the existing "# ---- Neoarcana ----" block in
# /etc/caddy/Caddyfile. Keeps www canonical, as the current config has it.
#
# What this replaces: the old block served the React SPA from
# /var/lib/caddy/celtic-cross-journey/dist and proxied only /reading to
# the legacy API on :8001. The new app serves its own pages, so the
# static root and the single-endpoint proxy both go away.

neoarcana.net {
	redir https://www.{host}{uri}
}

www.neoarcana.net {
	# Card images straight from disk. The app runs a single worker, so
	# keeping ~10 image requests per reading off it leaves it free to
	# stream interpretations.
	handle_path /static/* {
		root * /srv/neoarcana/app/static
		header Cache-Control "public, max-age=2592000, immutable"
		file_server
	}

	# The interpretation stream. Kept out of the `encode` block below:
	# Caddy flushes text/event-stream immediately, and compression
	# middleware is the one thing that can get in the way of that.
	@stream path_regexp ^/readings/[^/]+/stream$
	handle @stream {
		reverse_proxy 127.0.0.1:8001
	}

	handle {
		encode zstd gzip
		reverse_proxy 127.0.0.1:8001
	}
}
